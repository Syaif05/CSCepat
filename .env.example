# ==============================================================================
# KONFIGURASI SUPABASE & ENVIRONMENT PESANRAPI
# ==============================================================================
# Salin file ini menjadi .env.local dan isi dengan kredensial proyek Supabase Anda.
# Kredensial dapat ditemukan di: https://supabase.com/dashboard -> Project Settings -> API
# ==============================================================================

# URL Proyek Supabase Anda (Contoh: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Anon / Publishable API Key Supabase (Aman ditaruh di browser karena data dilindungi RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY

# URL Aplikasi (digunakan untuk redirect verifikasi email & reset password)
APP_URL=http://localhost:3000
